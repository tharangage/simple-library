# Copy this file to .env (cp .env.example .env). Vite reads .env for `npm run dev` and `npm run build`.
# Nothing here is secret: a browser app is a *public* OIDC client and can't keep secrets anyway.
# .env itself is git-ignored, so each developer (or environment) can point it somewhere else.
VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=library
VITE_KEYCLOAK_CLIENT_ID=library-web
