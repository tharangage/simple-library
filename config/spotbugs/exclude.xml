<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs + FindSecBugs exclusions for simple-library.
  Every entry needs a reason. Prefer fixing the code over adding entries here.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- JPA entities (Lombok @Data) and Spring constructor injection store/return
         mutable collaborators by design; these two patterns are pure noise here. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- FindSecBugs marks every @RestController method as "an endpoint" (informational only). -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- Stateless bearer-token API: no cookies or sessions, so CSRF protection is not needed.
         Revisit if session/cookie auth is ever added. -->
    <Match>
        <Class name="com.ascendion.roshan.simple_library.config.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>
</FindBugsFilter>
